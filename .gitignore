# Rust
/target/
# rust-analyzer builds into its own dir so it does not fight cargo's lock
/target/rust-analyzer/

# Godot editor/import cache
/project/.godot/

# macOS
.DS_Store

# Derived art: regenerated by `cargo art` from the committed GLB checkpoints.
/art/staging/
/art/preview/

# Python (Blender scripts; uv-managed)
.venv/
__pycache__/
*.pyc

# pytest-cov / coverage.py run state
.coverage
.pytest_cache/
htmlcov/

# bashunit run state
/.bashunit/

# lychee's link-result cache
/.lycheecache

