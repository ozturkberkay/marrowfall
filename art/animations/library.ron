// Every animation available to every character. A character spec lists names.
//
// - `skeleton`: which rig it drives. A clip only fits a character on the same one.
// - `fps`: how many sprite frames a second we bake. `source_fps`: the clip's own rate.
// - `travels`: true when the clip moves across the ground, false when it runs in place.
// - `source`: who sold the motion. Which file the fit read is `from`, in `library.lock`.
AnimationLibrary(
    animations: {
        "idle": Animation(
            skeleton: "humanoid",
            loops: true,
            fps: 8,
            // Key times 1/24 s apart in the committed GLB.
            source_fps: 24,
            // Runs in place: hips end where they started.
            travels: false,
            source: Meshy(action_id: 251),
        ),
        "run": Animation(
            skeleton: "humanoid",
            loops: true,
            fps: 24,
            source_fps: 24,
            // Runs in place: hips end where they started.
            travels: false,
            source: Meshy(action_id: 15),
        ),
        // Mixamo motion. Not redistributable, so it lives in the gitignored
        // `art/animations/local/`. Each machine runs `cargo art fetch`.
        "walk_back": Animation(
            skeleton: "humanoid",
            loops: true,
            fps: 20,
            source_fps: 30,
            // Travels 1.414 m backwards.
            travels: true,
            source: Mixamo(product_id: "c9ccc468-b96c-11e4-a802-0aaa78deedf9"),
        ),
        "strafe_left": Animation(
            skeleton: "humanoid",
            loops: true,
            fps: 24,
            source_fps: 30,
            // Travels 2.312 m sideways.
            travels: true,
            source: Mixamo(product_id: "c9c97b90-b96c-11e4-a802-0aaa78deedf9"),
        ),
        "strafe_right": Animation(
            skeleton: "humanoid",
            loops: true,
            fps: 24,
            source_fps: 30,
            travels: true,
            source: Mixamo(product_id: "c9c96f9e-b96c-11e4-a802-0aaa78deedf9"),
        ),
    },
)
